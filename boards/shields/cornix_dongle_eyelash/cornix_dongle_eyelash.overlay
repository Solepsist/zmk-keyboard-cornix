#include <dt-bindings/zmk/matrix_transform.h>

/{
    chosen {
        zephyr,display = &oled;
    };
};
// vim: set ft=dts :
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 20)>,
                <NRF_PSEL(TWIM_SCL, 0, 17)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 20)>,
                <NRF_PSEL(TWIM_SCL, 0, 17)>;
            low-power-enable;
        };
    };
};


&i2c0 {
	status = "okay";
	compatible = "nordic,nrf-twi";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
	oled: ssd1306@3c {
        /*
         * SSD1315 is commonly SSD1306-compatible on I2C.
         * If the image is horizontally shifted on your module, try
         * adjusting `segment-offset` (often 0 or 2).
         */
        compatible = "solomon,ssd1306";
        reg = <0x3c>;
        height = <64>;

        width = <128>;
        segment-offset = <0>;

        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        inversion-on;
        prechargep = <0x22>;

        // comment to rotate 180
        segment-remap;
        com-invdir;
	};
};

//vim: set ft=dts:
